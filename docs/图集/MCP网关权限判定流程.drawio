<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="MCP网关权限判定流程">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MCP 网关：AI 接口集中化的二维权限判定" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== 左侧：调用方 ===== -->
        <mxCell id="caller-box" value="调用方（全公司各业务系统/智能体）" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="caller-sys1" value="业务系统 A&#xa;(带身份 Token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="caller-box">
          <mxGeometry x="25" y="40" width="170" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="caller-sys2" value="业务系统 B&#xa;(带身份 Token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="caller-box">
          <mxGeometry x="25" y="95" width="170" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="caller-agent" value="智能体&#xa;(带身份 Token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="caller-box">
          <mxGeometry x="25" y="150" width="170" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="caller-note" value="身份按公司体系&#xa;system / org / user" style="text;html=1;fontSize=9;fontColor=#666666;align=center;" vertex="1" parent="caller-box">
          <mxGeometry x="25" y="200" width="170" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== 中间：MCP 网关（核心） ===== -->
        <mxCell id="gateway-box" value="MCP 网关（请求拦截 + 二维权限判定）" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="80" width="360" height="420" as="geometry"/>
        </mxCell>

        <!-- 身份提取 -->
        <mxCell id="gw-identity" value="① 提取身份&#xa;从 Token 解析 system / org / user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="gateway-box">
          <mxGeometry x="60" y="40" width="240" height="40" as="geometry"/>
        </mxCell>

        <!-- 第一关：查询权限 -->
        <mxCell id="gw-query" value="② 查询权限判定&#xa;该身份能看到哪些工具？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="gateway-box">
          <mxGeometry x="70" y="100" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="gw-query-detail" value="工具列表过滤：&#xa;只返回该身份有权可见的工具&#xa;(tools/list 响应被裁剪)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="gateway-box">
          <mxGeometry x="50" y="180" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- 第二关：调用权限 -->
        <mxCell id="gw-call" value="③ 调用权限判定&#xa;该身份能实际使用此工具？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="gateway-box">
          <mxGeometry x="70" y="250" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="gw-call-detail" value="调用时拦截：tools/call 请求&#xa;命中黑名单 -> 直接拒绝&#xa;命中白名单 -> 放行转发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="gateway-box">
          <mxGeometry x="50" y="330" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- 拒绝出口 -->
        <mxCell id="gw-deny" value="✗ 拒绝&#xa;返回权限不足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;dashed=1;" vertex="1" parent="gateway-box">
          <mxGeometry x="240" y="395" width="100" height="15" as="geometry"/>
        </mxCell>

        <!-- 网关内部连线 -->
        <mxCell id="gwe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="gateway-box" source="gw-identity" target="gw-query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gwe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="gateway-box" source="gw-query" target="gw-query-detail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gwe3" value="可见的工具被调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#666666;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="gateway-box" source="gw-query-detail" target="gw-call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gwe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="gateway-box" source="gw-call" target="gw-call-detail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 右侧：AI 接口 MCP Server ===== -->
        <mxCell id="serverb-box" value="AI 接口 MCP Server（AI 接口集中化）" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="240" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="sb-tool1" value="AI 工具：LLM 对话&#xa;(GPT / Claude / ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="serverb-box">
          <mxGeometry x="20" y="40" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sb-tool2" value="AI 工具：图像生成&#xa;(DALL-E / SD / ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="serverb-box">
          <mxGeometry x="20" y="95" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sb-tool3" value="AI 工具：语音 / 向量检索 / ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="serverb-box">
          <mxGeometry x="20" y="150" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sb-note" value="全公司 AI 接口统一封装&#xa;为 MCP 工具，集中管理" style="text;html=1;fontSize=9;fontColor=#666666;align=center;" vertex="1" parent="serverb-box">
          <mxGeometry x="20" y="200" width="200" height="30" as="geometry"/>
        </mxCell>

        <!-- 下游真实 AI 接口 -->
        <mxCell id="ai-upstream" value="下游真实 AI 接口&#xa;(OpenAI / Anthropic / 内部模型 / ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="350" width="240" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== 跨框连线 ===== -->

        <!-- 调用方 -> 网关 (tools/list 查询) -->
        <mxCell id="cross1" value="tools/list 查询&#xa;(带 Token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#9673a6;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.2;endArrow=block;endFill=1;" edge="1" parent="1" source="caller-box" target="gateway-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 调用方 -> 网关 (tools/call 调用) -->
        <mxCell id="cross2" value="tools/call 调用&#xa;(带 Token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#9673a6;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.6;entryX=0;entryY=0.75;endArrow=block;endFill=1;" edge="1" parent="1" source="caller-box" target="gateway-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 网关 -> AI 接口 MCP Server (放行) -->
        <mxCell id="cross3" value="放行（已通过二维权限）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#82b366;strokeColor=#82b366;strokeWidth=2.5;exitX=1;exitY=0.55;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="gateway-box" target="serverb-box">
          <mxGeometry relative="1" as="geometry" y="-30" />
        </mxCell>

        <!-- AI 接口 MCP Server -> 下游 AI 接口 -->
        <mxCell id="cross4" value="转发到真实 AI 接口" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#666666;strokeColor=#666666;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="serverb-box" target="ai-upstream">
          <mxGeometry relative="1" as="geometry" x="50" />
        </mxCell>

        <!-- 网关 -> 拒绝出口（返回调用方） -->
        <mxCell id="cross5" value="拒绝时直接返回&#xa;不转发到 AI 接口 MCP Server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#b85450;strokeColor=#b85450;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.95;entryX=1;entryY=0.9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="gateway-box" target="caller-box">
          <mxGeometry relative="1" as="geometry" x="-45">
            <Array as="points">
              <mxPoint x="300" y="479"/>
              <mxPoint x="300" y="296"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
