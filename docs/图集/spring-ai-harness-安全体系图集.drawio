        <!-- 存储层 → 安全层 -->
        <mxCell id="edge5" value="getFullKey()&#xa;单点路径安全" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#b85450;strokeColor=#b85450;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="storage-layer" target="security-layer">
          <mxGeometry relative="1" as="geometry" y="65" />
        </mxCell>

        <!-- 中继工具 → 沙箱 MCP -->
        <mxCell id="edge6" value="透明转发 (携带相同 Authorization)&#xa;中继工具调用 → 下游沙箱 MCP Server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#d79b00;strokeColor=#d79b00;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="relay-tools" target="sandbox-mcp">
          <mxGeometry relative="1" as="geometry" y="-80">
            <Array as="points">
              <mxPoint x="1050" y="424"/>
              <mxPoint x="1050" y="355"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 沙箱 MCP → 沙箱容器 -->
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sandbox-mcp" target="sandbox-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 工厂 → OSS -->
        <mxCell id="edge8" value="输入流传入 → 流式解析 （防 OOM）&#xa;路径前缀隔离：不同身份不同前缀" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#666666;strokeColor=#666666;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.25;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="factory" target="oss-box">
          <mxGeometry relative="1" as="geometry" y="-60" />
        </mxCell>

        <!-- 沙箱 → OSS (挂载) -->
        <mxCell id="edge9" value="/workspace 挂载&#xa;(同一套身份体系)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#d79b00;strokeColor=#d79b00;strokeWidth=1.5;dashed=1;exitX=1;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sandbox-box" target="oss-box">
          <mxGeometry relative="1" as="geometry" x="40">
            <Array as="points">
              <mxPoint x="1380" y="320"/>
              <mxPoint x="1380" y="460"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend" value="图例" style="swimlane;startSize=22;fillColor=none;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="250" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="leg1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend">
          <mxGeometry x="10" y="28" width="24" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="leg1t" value="文件管理安全体系（静态安全）" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="42" y="26" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend">
          <mxGeometry x="10" y="48" width="24" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="leg2t" value="沙箱执行安全体系（动态安全）" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="42" y="46" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend">
          <mxGeometry x="10" y="68" width="24" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="leg3t" value="安全层 / 拒绝路径" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="42" y="66" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="legend">
          <mxGeometry x="10" y="88" width="24" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="leg4t" value="MCP Server 核心框架" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="42" y="86" width="200" height="20" as="geometry"/>
        </mxCell>

      </root>
