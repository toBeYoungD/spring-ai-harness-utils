        </mxCell>
        <mxCell id="ov-browser" value="Browser 执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="overview-box">
          <mxGeometry x="135" y="330" width="110" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ov-computer" value="Computer 执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="overview-box">
          <mxGeometry x="255" y="330" width="110" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="ov-mount" value="/workspace 挂载 ← OSS 工作区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="overview-box">
          <mxGeometry x="80" y="390" width="220" height="30" as="geometry"/>
        </mxCell>

        <!-- 中继代理核心说明 -->
        <mxCell id="ov-note1" value="RelayTools 工作原理" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="overview-box">
          <mxGeometry x="20" y="450" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="ov-note2" value="1. 将自身注册为 MCP Server&#xa;2. 在特定工具上透明转发到下游&#xa;3. 携带相同的 Authorization 头&#xa;4. 连接可复用，用完关闭" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="overview-box">
          <mxGeometry x="20" y="470" width="340" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ov-note3" value="关键设计决策" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="overview-box">
          <mxGeometry x="20" y="540" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="ov-note4" value="● 中继功能可配置开关 (relay.enabled)&#xa;● 关闭时这些工具从工具列表消失&#xa;● 本地工具和中继工具在同一个 /mcp&#xa;   端点下共存，对客户端完全透明&#xa;● same Authorization header → same&#xa;   workspace 在沙箱中挂载" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="overview-box">
          <mxGeometry x="20" y="560" width="340" height="80" as="geometry"/>
        </mxCell>

        <!-- 总览连线 -->
        <mxCell id="ove1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="overview-box" source="ov-agent" target="ov-mcp">
