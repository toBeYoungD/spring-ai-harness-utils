        <mxCell id="ann-arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="annotation" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="快照与回滚流程">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="快照与回滚流程 — 双重兜底机制" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== 左侧：前置快照流程 ===== -->
        <mxCell id="pre-box" value="一、前置快照（自动触发，对智能体透明）" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="400" height="400" as="geometry"/>
        </mxCell>

        <mxCell id="pre-trigger" value="破坏性操作触发" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="pre-box">
          <mxGeometry x="110" y="35" width="180" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="pre-trigger-text" value="触发条件：Write（文件已存在）/ Edit / Trash" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="pre-box">
          <mxGeometry x="15" y="105" width="170" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="pre-read" value="读取当前文件内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="pre-box">
          <mxGeometry x="120" y="165" width="160" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="pre-meta" value="生成快照 ID：timestamp_counter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="pre-box">
          <mxGeometry x="120" y="215" width="160" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="pre-store" value="存储快照副本 + 元数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="pre-box">
          <mxGeometry x="120" y="265" width="160" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="pre-path" value="路径：.snapshots/{snapshotId}/{filePath}&#xa;元数据：meta.txt (filePath, action, timestamp)" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="pre-box">
          <mxGeometry x="30" y="310" width="350" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="pre-done" value="快照创建完成 → 继续执行原操作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="pre-box">
          <mxGeometry x="80" y="355" width="240" height="30" as="geometry"/>
        </mxCell>

        <!-- 前置快照内部连线 -->
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="pre-box" source="pre-trigger" target="pre-read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="pre-box" source="pre-read" target="pre-meta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="pre-box" source="pre-meta" target="pre-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=1;entryX=1;entryY=0;" edge="1" parent="pre-box" source="pre-store" target="pre-done">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="300"/>
              <mxPoint x="390" y="355"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== 右侧：回滚流程 ===== -->
        <mxCell id="rewind-box" value="二、回滚流程（Rewind — 双重兜底）" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="420" height="400" as="geometry"/>
        </mxCell>

        <mxCell id="rw-start" value="调用 Rewind(snapshotId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="rewind-box">
          <mxGeometry x="120" y="35" width="180" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="rw-load" value="加载快照元数据，校验快照有效性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="rewind-box">
          <mxGeometry x="105" y="85" width="210" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="rw-safety" value="⚡ 关键步骤：创建&quot;回滚前&quot;安全快照&#xa;（action = REWIND）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="rewind-box">
          <mxGeometry x="80" y="140" width="260" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="rw-why" value="意义：保证回滚操作本身也可以被撤销&#xa;（undo-of-undo / 撤销的撤销）" style="text;html=1;fontSize=10;fontColor=#b85450;align=center;" vertex="1" parent="rewind-box">
          <mxGeometry x="60" y="190" width="300" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="rw-restore" value="读取快照内容 → 覆盖当前文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="rewind-box">
          <mxGeometry x="105" y="235" width="210" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="rw-result" value="返回：Successfully rewound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="rewind-box">
          <mxGeometry x="115" y="295" width="190" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="rw-again" value="如果回滚错误 → 再次 Rewind 到&quot;回滚前&quot;快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;dashed=1;" vertex="1" parent="rewind-box">
          <mxGeometry x="60" y="350" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- 回滚内部连线 -->
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="rewind-box" source="rw-start" target="rw-load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="rewind-box" source="rw-load" target="rw-safety">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=1;entryX=1;entryY=0;" edge="1" parent="rewind-box" source="rw-safety" target="rw-restore">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="185"/>
              <mxPoint x="370" y="235"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="rewind-box" source="rw-restore" target="rw-result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="rewind-box" source="rw-result" target="rw-again">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 底部：隐藏路径 + 说明 ===== -->
        <mxCell id="hidden-box" value="三、透明存储（智能体不可见）" style="swimlane;startSize=22;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="880" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="hidden-tree" value="工作区根目录 (智能体视角)&#xa;├ src/&#xa;├ package.json&#xa;└ ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="hidden-box">
          <mxGeometry x="30" y="30" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="hidden-full" value="实际 OSS 存储路径&#xa;{prefix}/&#xa;├ src/&#xa;├ package.json&#xa;├ .snapshots/ ← 被 IGNORED_PATH_PATTERN 过滤&#xa;│   └ {snapshotId}/meta.txt + 文件副本&#xa;├ .trash/ ← 智能体不可见&#xa;└ .shadow/ ← 影子缓存，智能体不可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;" vertex="1" parent="hidden-box">
          <mxGeometry x="250" y="30" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="hidden-arrow" value="过滤规则拦截 →" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#b85450;strokeColor=#b85450;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="hidden-box" source="hidden-tree" target="hidden-full">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="hidden-note" value="智能体的 ListDirectory / Glob / Grep 永远不会返回 .snapshots/ .trash/ .shadow/ 目录" style="text;html=1;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="hidden-box">
          <mxGeometry x="580" y="40" width="280" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== 时间线示意 ===== -->
        <mxCell id="timeline-box" value="四、时间线示例" style="swimlane;startSize=22;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="880" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="t1" value="T1: 创建文件 A&#xa;(v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="timeline-box">
          <mxGeometry x="15" y="40" width="100" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="T2: 编辑文件 A&#xa;(v2) → 前置快照 S1 (v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="timeline-box">
          <mxGeometry x="145" y="40" width="155" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="T3: 再次编辑 A&#xa;(v3) → 前置快照 S2 (v2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="timeline-box">
          <mxGeometry x="330" y="40" width="160" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="T4: Rewind → S2&#xa;先创建 S3 (v3, action=REWIND)&#xa;再将文件恢复到 v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="timeline-box">
          <mxGeometry x="520" y="40" width="170" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="T5: 撤销回滚 → Rewind S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;dashed=1;" vertex="1" parent="timeline-box">
          <mxGeometry x="720" y="40" width="140" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="t-arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="timeline-box" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="timeline-box" source="t2" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="timeline-box" source="t3" target="t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="timeline-box" source="t4" target="t5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="沙箱工具中继流程">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="沙箱工具中继流程 — 懒加载 + 透明代理" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== 阶段一：工具注册（启动时） ===== -->
        <mxCell id="phase1-box" value="阶段一：工具定义预加载（智能体启动时，不创建沙箱）" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="440" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="p1-init" value="HarnessAgent 启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="phase1-box">
          <mxGeometry x="30" y="35" width="140" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p1-create" value="创建 LazyLoadSandboxCreator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="phase1-box">
          <mxGeometry x="30" y="80" width="180" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p1-fetchdefs" value="通过临时 MCP 连接获取&#xa;沙箱侧工具定义列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="phase1-box">
          <mxGeometry x="30" y="125" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p1-filter" value="安全过滤（白名单）&#xa;仅保留 24 个 browser_* +&#xa;computer + shell + ipython" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="phase1-box">
          <mxGeometry x="30" y="175" width="180" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="p1-wrapper" value="包装为 FunctionToolCallback&#xa;（调用时才触发真实连接）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="phase1-box">
          <mxGeometry x="250" y="120" width="170" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p1-bundle" value="与其他工具捆绑注册&#xa;到 ChatClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="phase1-box">
          <mxGeometry x="250" y="175" width="170" height="35" as="geometry"/>
        </mxCell>

        <!-- 阶段一内部连线 -->
        <mxCell id="p1e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="phase1-box" source="p1-init" target="p1-create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="phase1-box" source="p1-create" target="p1-fetchdefs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="phase1-box" source="p1-fetchdefs" target="p1-filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="phase1-box" source="p1-filter" target="p1-wrapper">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="phase1-box" source="p1-wrapper" target="p1-bundle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

                <!-- ===== 阶段二：懒加载触发（运行时） ===== -->
        <mxCell id="phase2-box" value="阶段二：懒加载触发（智能体实际调用沙箱工具时）" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="440" height="380" as="geometry"/>
        </mxCell>

        <mxCell id="p2-call" value="智能体调用&#xa;run_shell_command(&quot;ls&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="phase2-box">
          <mxGeometry x="140" y="30" width="160" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="p2-check" value="检查：沙箱连接&#xa;是否已建立？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="phase2-box">
          <mxGeometry x="165" y="85" width="110" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="p2-connect" value="首次调用：创建 MCP 连接&#xa;沙箱 Pod 启动 / /workspace 挂载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="phase2-box">
          <mxGeometry x="20" y="170" width="170" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="p2-reuse" value="后续调用：复用已有连接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="phase2-box">
          <mxGeometry x="250" y="175" width="170" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="p2-forward" value="获取真实 ToolCallback&#xa;转发工具调用到沙箱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="phase2-box">
          <mxGeometry x="140" y="250" width="160" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="p2-exec" value="沙箱执行命令 -> 返回结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="phase2-box">
          <mxGeometry x="140" y="305" width="160" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="p2-clean" value="🔒 会话结束&#xa;关闭连接，释放沙箱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;dashed=1;" vertex="1" parent="phase2-box">
          <mxGeometry x="320" y="305" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- 阶段二内部连线 -->
        <mxCell id="p2e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="phase2-box" source="p2-call" target="p2-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e2" value="首次" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#b85450;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="phase2-box" source="p2-check" target="p2-connect">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="105" y="112"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2e3" value="后续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#82b366;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="phase2-box" source="p2-check" target="p2-reuse">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="335" y="112"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="phase2-box" source="p2-connect" target="p2-forward">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="105" y="267"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="phase2-box" source="p2-reuse" target="p2-forward">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="335" y="267"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="phase2-box" source="p2-forward" target="p2-exec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="phase2-box" source="p2-exec" target="p2-clean">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

<!-- ===== 阶段三：结果返回 ===== -->
        <mxCell id="phase3-box" value="阶段三：结果透明返回（智能体感知不到中继的存在）" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="440" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="p3-result" value="沙箱执行结果返回&#xa;stdout / stderr / returncode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="phase3-box">
          <mxGeometry x="15" y="35" width="170" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p3-pass" value="MCP CallToolResult&#xa;原样透传给智能体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="phase3-box">
          <mxGeometry x="220" y="35" width="170" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p3-transparent" value="对智能体来说，run_shell_command 就像本地工具一样——&#xa;它不知道执行发生在远程沙箱容器中" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="phase3-box">
          <mxGeometry x="50" y="90" width="340" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="p3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="phase3-box" source="p3-result" target="p3-pass">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 右侧：MCP Server 中继代理大局 ===== -->
        <mxCell id="overview-box" value="中继架构总览" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="380" height="790" as="geometry"/>
        </mxCell>

        <mxCell id="ov-agent" value="智能体 (Agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="overview-box">
          <mxGeometry x="100" y="35" width="180" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="ov-mcp" value="Harness MCP Server&#xa;(POST /mcp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="overview-box">
          <mxGeometry x="100" y="100" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="ov-local" value="本地文件工具&#xa;Read / Write / Edit ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="overview-box">
          <mxGeometry x="20" y="180" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="ov-relay" value="中继工具&#xa;browser_* / shell / ipython / computer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="overview-box">
          <mxGeometry x="200" y="180" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="ov-sandbox" value="沙箱 MCP Server&#xa;(AgentRun 容器)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="overview-box">
          <mxGeometry x="100" y="260" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="ov-shell" value="Shell 执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="overview-box">
