        <mxCell id="ove2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="overview-box" source="ov-mcp" target="ov-local">
          <mxGeometry relative="1" as="geometry">
