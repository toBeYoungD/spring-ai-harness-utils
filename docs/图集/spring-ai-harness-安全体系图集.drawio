              <mxPoint x="190" y="160"/>
              <mxPoint x="100" y="160"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ove3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="overview-box" source="ov-mcp" target="ov-relay">
