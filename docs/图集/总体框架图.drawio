        <!-- 存储层 → 安全层 -->
        <mxCell id="edge5" value="getFullKey()&#xa;单点路径安全" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#b85450;strokeColor=#b85450;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="storage-layer" target="security-layer">
          <mxGeometry relative="1" as="geometry" y="65" />
        </mxCell>

        <!-- 中继工具 → 沙箱 MCP -->
        <mxCell id="edge6" value="透明转发 (携带相同 Authorization)&#xa;中继工具调用 → 下游沙箱 MCP Server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#d79b00;strokeColor=#d79b00;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="relay-tools" target="sandbox-mcp">
