        <mxCell id="p3-pass" value="MCP CallToolResult&#xa;原样透传给智能体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="phase3-box">
