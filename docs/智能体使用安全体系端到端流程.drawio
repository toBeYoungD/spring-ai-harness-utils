<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="智能体使用安全体系端到端流程">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="智能体主流程与工具代理（含防护插桩）" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="640" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== 主线 ①②④（居中） ==================== -->
        <mxCell id="main1" value="① 智能体发起请求&#xa;携带 Authorization: {system}-{agent}-{user}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="main2" value="② MCP Server 装配存储实例 + 工具路由&#xa;(本地文件工具 / 中继工具)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="main4" value="④ 结果返回智能体&#xa;全程透明，智能体无感" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="560" width="280" height="50" as="geometry"/>
        </mxCell>

        <!-- 主线 ①->② -->
        <mxCell id="flow12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="main1" target="main2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== 左路：文件工具（静态安全） ==================== -->
        <mxCell id="ef-tool" value="文件工具&#xa;Read / Write / Edit ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="250" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="ef-storage" value="StorageProvider&#xa;(前缀绑定，本机直接调用)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="310" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="ef-oss" value="阿里云 OSS&#xa;(工作区前缀下)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="370" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="efe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="ef-tool" target="ef-storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="efe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="ef-storage" target="ef-oss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 分流：main2 -> 文件路 / 中继路 -->
        <mxCell id="split-file" value="本地工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#82b366;strokeColor=#82b366;strokeWidth=2;exitX=0.25;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="main2" target="ef-tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== 右路：中继工具代理（动态安全） ==================== -->
        <mxCell id="er-tool" value="中继工具&#xa;run_shell_command / browser_* / computer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="250" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="er-proxy" value="MCP Server 代理转发&#xa;(工具中继 Relay，携带相同身份)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="310" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="er-sandmcp" value="下游沙箱 MCP Server&#xa;(透明转发目标)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="370" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="er-sandbox" value="沙箱容器执行&#xa;(/workspace 挂载同一工作区)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="430" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="ere1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="er-tool" target="er-proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ere2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="er-proxy" target="er-sandmcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ere3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="er-sandmcp" target="er-sandbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 分流：main2 -> 中继路 -->
        <mxCell id="split-relay" value="中继工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#d79b00;strokeColor=#d79b00;strokeWidth=2;exitX=0.75;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="main2" target="er-tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 汇合：文件路 / 中继路 -> main4 -->
        <mxCell id="merge-file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.25;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="ef-oss" target="main4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="merge-relay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.75;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="er-sandbox" target="main4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== 防护措施（🛡，挂关键节点） ==================== -->
        <mxCell id="shield-auth" value="🛡 身份认证&#xa;三段式身份，无状态校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="72" width="200" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="shield-file" value="🛡 路径安全 + 前置快照&#xa;绝对路径拒绝 / 可回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="308" width="200" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="shield-transparent" value="🛡 全程透明&#xa;智能体感知不到安全机制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="562" width="200" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="shield-iso-quota" value="🛡 工作区隔离 + 配额&#xa;前缀绑定 / 装饰器零开销" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="154" width="200" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="shield-sandbox" value="🛡 沙箱懒加载 + 工作区挂载&#xa;按需创建 / 同一身份同一前缀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="428" width="200" height="46" as="geometry"/>
        </mxCell>

        <!-- 防护虚线 -->
        <mxCell id="lk-auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="shield-auth" target="main1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lk-file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="shield-file" target="ef-storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lk-transparent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="shield-transparent" target="main4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lk-iso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=none;" edge="1" parent="1" source="shield-iso-quota" target="main2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lk-sandbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=none;" edge="1" parent="1" source="shield-sandbox" target="er-sandbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend" value="图例" style="swimlane;startSize=22;fillColor=none;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="650" width="440" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="leg-main" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="legend">
          <mxGeometry x="15" y="28" width="24" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="leg-main-t" value="主线（智能体动作）" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="45" y="26" width="150" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="leg-file" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend">
          <mxGeometry x="15" y="48" width="24" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="leg-file-t" value="文件工具路（静态安全）" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="45" y="46" width="170" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="leg-relay" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend">
          <mxGeometry x="15" y="68" width="24" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="leg-relay-t" value="中继工具代理路（动态安全）" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="45" y="66" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="leg-shield" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend">
          <mxGeometry x="240" y="28" width="24" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="leg-shield-t" value="🛡 防护措施（插桩）" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="270" y="26" width="160" height="18" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
