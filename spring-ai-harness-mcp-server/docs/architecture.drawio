        <mxCell id="p3-prefix" value="工作区存储前缀&#10;每个身份独占一块,互不可见" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="185" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-noteleft" value="当前实现以请求头携带身份;具体格式为测试期方案,&#10;可替换为独立鉴权模块,不影响隔离原则" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="255" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-tright" value="安全细则(原则,非实现细节)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p3-r1" value="① 所有文件路径强制约束在该身份的工作区前缀内" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3-r2" value="② 绝对路径(以 / 开头)直接拒绝,防止越权" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="145" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3-r3" value="③ 内部目录(.snapshots / .trash / .shadow)对用户不可见" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3-r4" value="④ 返回信息不含存储真实路径,仅返回相对路径" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="255" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3-r5" value="⑤ 身份标识是工作区隔离的唯一来源" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="310" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3-noteright" value="强调安全细则本身;具体校验函数为实现细节,可随实现演进替换" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="365" width="500" height="30" as="geometry" />
