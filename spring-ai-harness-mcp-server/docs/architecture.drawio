        </mxCell>
        <mxCell id="p4-note" value="修改/删除类操作均有安全前置(快照 / 回收站),保证可恢复" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="160" y="570" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-start" target="p4-judge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e2" value="读" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p4-judge" target="p4-read"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e3" value="改" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p4-judge" target="p4-modify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e4" value="删" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p4-judge" target="p4-delete"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-read" target="p4-readflow"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-modify" target="p4-snap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-snap" target="p4-write"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-delete" target="p4-trash"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-readflow" target="p4-end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-write" target="p4-end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p4-trash" target="p4-end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5-配额装饰器流程" id="page5">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5-title" value="配额装饰器流程 - QuotaEnforcedStorageProvider.writeString" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="0" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-start" value="writeString(path, content) 进入配额装饰器" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="40" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p5-j1" value="是否排除路径?&#10;(.snapshots / .trash / .shadow / .storage&#10;或按 include 配置不计入)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="255" y="115" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5-skip" value="直接 delegate.writeString&#10;(跳过计费,原样写)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="130" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5-newsize" value="计算 newSize = content 字节数(UTF-8)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="240" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p5-oldsize" value="获取 oldSize(若文件已存在且非目录)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="315" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p5-delta" value="delta = newSize - oldSize" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="390" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p5-j2" value="delta &gt; 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="305" y="465" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5-check" value="quotaManager.checkQuota&#10;(校验 used+delta 是否超限)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="580" y="470" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p5-exceed" value="抛 QuotaExceededException&#10;(中断,不写入)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="555" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p5-write" value="delegate.writeString(真正写入)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="270" y="575" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p5-update" value="quotaManager.updateUsedBytes(delta)&#10;增量更新 .storage 元文件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="270" y="650" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p5-end" value="完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="335" y="730" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p5-start" target="p5-j1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p5-j1" target="p5-skip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p5-j1" target="p5-newsize"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p5-newsize" target="p5-oldsize"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p5-oldsize" target="p5-delta"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p5-delta" target="p5-j2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p5-j2" target="p5-check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e8" value="超限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="p5-check" target="p5-exceed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e9" value="未超限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p5-check" target="p5-write"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e10" value="否(delta≤0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="p5-j2" target="p5-write"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p5-write" target="p5-update"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="p5-update" target="p5-end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e13" value="写入并返回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;dashed=1;" edge="1" parent="1" source="p5-skip" target="p5-end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-note" value="装饰器只拦截改变占用的操作(写/删/移动);读取类直接放行。关闭配额时工厂返回裸 Storage,零开销。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="790" width="700" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6-文件与执行安全多重保障" id="page6">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6-title" value="文件与执行安全多重保障" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="0" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-sub" value="文件系统侧 + 执行沙箱侧,双重维度保障安全" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="270" y="30" width="700" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p6-lefth" value="文件系统安全(本 MCP Server 保障)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p6-righth" value="执行沙箱安全(python / shell / browser_use)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="560" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p6-m1" value="① 工作区隔离&#10;每个身份独占存储前缀,路径强制约束在前缀内&#10;效果:杜绝跨工作区越权访问" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="540" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-m2" value="② 版本快照与回退&#10;写/编辑前自动快照,支持 Rewind 回退&#10;效果:误改可回退到历史版本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="540" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-m3" value="③ 回收站软删除&#10;删除移入 .trash/ 而非物理删除&#10;效果:误删可恢复" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="540" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-s1" value="④ 容器级隔离&#10;python / shell / browser_use 在独立沙箱执行,按用户/会话隔离&#10;效果:执行环境互不影响" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-s2" value="⑤ 工作区挂载&#10;沙箱挂载该用户工作区,可访问但不可越界&#10;效果:执行权限不突破文件隔离" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="205" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-s3" value="⑥ 执行与存储分离&#10;执行环境独立于文件存储,危险操作不波及他人&#10;效果:危险代码被限制在沙箱内" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="290" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-summary" value="文件侧:访问受控 · 误改可退 · 误删可恢(文件不丢失)&#10;执行侧:python / shell / browser_use 沙箱隔离(执行受控)&#10;=&gt; 文件与执行双重安全保障" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="395" width="1000" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6-note" value="文件系统与沙箱分离:文件操作无需容器,少量资源服务多用户;执行类按需开沙箱,资源按用户隔离" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="480" width="760" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
